# ==========================================
# Offline Local AI Model Settings
# ==========================================
VITE_OFFLINE_MODE=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# Optional: Cloud fallback (leave empty for 100% offline air-gapped mode)
GEMINI_API_KEY=""

# PORT: Local dev port. Cloud Run injects its own PORT (8080) and the server reads it
# from the environment, so do not hardcode this in deployment.
PORT=3000

NODE_ENV=development

# ALLOWED_ORIGINS: Comma-separated browser origins permitted to call the API cross-origin.
# Only needed on the deployed backend (Cloud Run), where the frontend is on a different origin.
# Defaults to the Firebase Hosting domains plus http://localhost:3000.
# ALLOWED_ORIGINS="https://tender-scrutiny-assistant.web.app,http://localhost:3000"

# VITE_API_BASE_URL: Where the frontend sends API calls. Baked into the bundle at build time.
# Leave empty for local dev (backend serves the frontend on the same origin).
# Set to the Cloud Run service URL when building the bundle deployed to Firebase Hosting.
# VITE_API_BASE_URL="https://tba-api-xxxxxxxxxx-el.a.run.app"

# Demo (guest) mode for hackathon judges: anonymous sessions get a daily AI allowance.
# Google-signed-in users are never capped. Requires Anonymous sign-in enabled in Firebase Auth.
# DEMO_EXTRACTIONS_PER_GUEST=3   # PDF/NIT extractions per guest per day (IST)
# DEMO_QUERIES_PER_GUEST=10      # AI technical queries per guest per day
# DEMO_DAILY_TOTAL=50            # all guests combined per day; this is what bounds Gemini spend
